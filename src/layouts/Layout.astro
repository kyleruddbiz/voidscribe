---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Void Scribe Studios — an independent game studio.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/voidscribe-vortex.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img
          src="/images/voidscribe-logo.svg"
          alt="Void Scribe Studios"
          width="160"
          height="80"
        />
      </a>
      <nav>
        <a href="/kyle-rudd">Kyle Rudd</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Logo design by Garrett Christensen. &copy; {new Date().getFullYear()} Void Scribe Studios.
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0;
  }

  .brand img {
    height: 3rem;
    width: auto;
    /* the source logo is black-on-transparent; invert it for the dark theme */
    filter: invert(1) brightness(1.6);
  }

  nav a {
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--color-text-dim);
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent-bright);
    border-bottom-color: var(--color-accent);
  }

  main {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    min-height: 60vh;
  }

  .site-footer {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 0.85rem;
  }

  .site-footer p {
    margin: 1.5rem 0 0;
  }
</style>
