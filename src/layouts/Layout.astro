---
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og-voidscribe.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/images/voidscribe-vortex.svg"
    />
    <meta name="theme-color" content="#0d0e12" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="sr-only skip-link" href="#main">
      Skip to content
    </a>

    <header class="site-header">
      <a class="brand" href="/">
        <img
          src="/images/voidscribe-logo.svg"
          alt={`${site.name} — home`}
          width="160"
          height="80"
        />
      </a>
      <nav>
        <a href="/kyle-rudd">Kyle Rudd</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Logo design by Garrett Christensen. &copy; {new Date().getFullYear()}{' '}
        {site.name}.
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header,
  main,
  .site-footer {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter);
    padding: var(--gutter) var(--gutter) 0;
  }

  .brand img {
    height: 3rem;
    width: auto;
    /* the source logo is black-on-transparent; invert it for the dark theme */
    filter: invert(1) brightness(1.6);
  }

  nav a {
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--color-text-dim);
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent-bright);
    border-bottom-color: var(--color-accent);
  }

  main {
    padding: 3rem var(--gutter) 5rem;
    min-height: 60dvh;
  }

  /* .sr-only hides this until focused, then this override makes it a normal
     visible, positioned element again. */
  .skip-link:focus {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    width: auto;
    height: auto;
    padding: 0.75rem 1.25rem;
    clip-path: none;
    white-space: normal;
    background: var(--color-bg-raised);
    color: var(--color-text);
  }

  .site-footer {
    padding: var(--gutter) var(--gutter) 3rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 0.85rem;
  }

  .site-footer p {
    margin: 1.5rem 0 0;
  }
</style>
