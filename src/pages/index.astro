---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';
---

<Layout>
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0 0 1rem;
  }

  .tagline {
    color: var(--color-text-dim);
    font-size: 1.1rem;
    max-width: var(--measure);
  }
</style>
