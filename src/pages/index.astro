---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Void Scribe Studios"
  description="An independent game studio crafting cozy horror — small, strange worlds that are unsettling to visit and hard to leave."
>
  <section class="hero">
    <h1>Void Scribe Studios</h1>
    <p class="tagline">
      An independent game studio crafting cozy horror — small, strange worlds
      that are unsettling to visit and hard to leave.
    </p>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0 0 1rem;
  }

  .tagline {
    color: var(--color-text-dim);
    font-size: 1.1rem;
    max-width: var(--measure);
  }
</style>
