---
import { firstLandingHref } from '../lib/landing-destination';

const fallback = firstLandingHref();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0e12" />
    <meta name="robots" content="noindex" />
    <title>Void Scribe Studios</title>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    </noscript>
    <style>
      html {
        background: #0d0e12;
      }
    </style>
    <script>
      import { randomLandingHref } from '../lib/landing-destination';

      location.replace(randomLandingHref());
    </script>
  </head>
  <body></body>
</html>
