    <section class="portfolio">
      <h2>Portfolio</h2>
      <a
        class="project"
        href="https://www.linkedin.com/in/kyle-n-rudd/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="project-main">
          <svg class="project-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span class="project-title">LinkedIn</span>
        </span>
        <span class="project-meta">View profile &rarr;</span>
      </a>
      <a
        class="project"
        href="https://voidscribestudios.itch.io/mtg-simulator?REDACTED"
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        <span class="project-main">
          <svg class="project-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.13 1.338C2.08 1.96.02 4.328 0 4.95v1.03c0 1.303 1.22 2.45 2.325 2.45 1.33 0 2.436-1.102 2.436-2.41 0 1.308 1.07 2.41 2.4 2.41 1.328 0 2.362-1.102 2.362-2.41 0 1.308 1.137 2.41 2.466 2.41h.024c1.33 0 2.466-1.102 2.466-2.41 0 1.308 1.034 2.41 2.363 2.41 1.33 0 2.4-1.102 2.4-2.41 0 1.308 1.106 2.41 2.435 2.41C22.78 8.43 24 7.282 24 5.98V4.95c-.02-.62-2.082-2.99-3.13-3.612-3.253-.114-5.508-.134-8.87-.133-3.362 0-7.945.053-8.87.133zm6.376 6.477a2.74 2.74 0 0 1-.468.602c-.5.49-1.19.795-1.947.795a2.786 2.786 0 0 1-1.95-.795c-.182-.178-.32-.37-.446-.59-.127.222-.303.412-.486.59a2.788 2.788 0 0 1-1.95.795c-.092 0-.187-.025-.264-.052-.107 1.113-.152 2.176-.168 2.95v.005l-.006 1.167c.02 2.334-.23 7.564 1.03 8.85 1.952.454 5.545.662 9.15.663 3.605 0 7.198-.21 9.15-.664 1.26-1.284 1.01-6.514 1.03-8.848l-.006-1.167v-.004c-.016-.775-.06-1.838-.168-2.95-.077.026-.172.052-.263.052a2.788 2.788 0 0 1-1.95-.795c-.184-.178-.36-.368-.486-.59-.127.22-.265.412-.447.59a2.786 2.786 0 0 1-1.95.794c-.76 0-1.446-.303-1.948-.793a2.74 2.74 0 0 1-.468-.602 2.738 2.738 0 0 1-.463.602 2.787 2.787 0 0 1-1.95.794h-.16a2.787 2.787 0 0 1-1.95-.793 2.738 2.738 0 0 1-.464-.602zm-2.004 2.59v.002c.795.002 1.5 0 2.373.953.687-.072 1.406-.108 2.125-.107.72 0 1.438.035 2.125.107.873-.953 1.578-.95 2.372-.953.376 0 1.876 0 2.92 2.934l1.123 4.028c.832 2.995-.266 3.068-1.636 3.07-2.03-.075-3.156-1.55-3.156-3.025-1.124.184-2.436.276-3.748.277-1.312 0-2.624-.093-3.748-.277 0 1.475-1.125 2.95-3.156 3.026-1.37-.004-2.468-.077-1.636-3.072l1.122-4.027c1.045-2.934 2.545-2.934 2.92-2.934zM12 12.714c-.002.002-2.14 1.964-2.523 2.662l1.4-.056v1.22c0 .056.56.033 1.123.007.562.026 1.124.05 1.124-.008v-1.22l1.4.055C14.138 14.677 12 12.713 12 12.713z"/></svg>
          <span class="project-title"><i>Magic: The Gathering</i> Simulator</span>
        </span>
        <span class="project-meta">Play on itch.io &rarr;</span>
      </a>
      <div class="project project--expandable">
        <a
          class="project-link"
          href="https://www.youtube.com/watch?v=tcXh7IcB0-I"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="project-content">
            <span class="project-main">
              <svg class="project-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              <span class="project-title">Family Trip Mix 2 (Sellout Edition)</span>
            </span>
            <p class="project-description" id="project-description-family-trip-mix-2">
              A psychedelic satire of the modern advertising hellscape, expressed through a genre-bending collage of image and sound.
            </p>
          </div>
          <span class="project-meta">Watch on YouTube &rarr;</span>
        </a>
        <button
          type="button"
          class="project-expand"
          aria-expanded="false"
          aria-controls="project-description-family-trip-mix-2"
          hidden
        >
          Show more
        </button>
      </div>
    </section>
  </section>
</Layout>

<script>
  const COLLAPSED_LINES = 2;

  const getControlledButton = (description: HTMLElement) =>
    document.querySelector<HTMLButtonElement>(`.project-expand[aria-controls="${description.id}"]`);

  const updateClamping = (description: HTMLElement) => {
    const button = getControlledButton(description);
    if (!button || description.classList.contains('is-expanded')) {
      return;
    }

    // Measure the description's true natural height rather than trusting a
    // -webkit-line-clamp box's own scrollHeight/clientHeight: that legacy
    // box model can misreport those values, causing false "it's truncated"
    // positives even when every word is already visible.
    description.classList.remove('is-clamped');
    const lineHeight = parseFloat(getComputedStyle(description).lineHeight);
    const maxHeight = lineHeight * COLLAPSED_LINES;
    const needsClamp = description.scrollHeight > maxHeight + lineHeight / 2;

    description.classList.toggle('is-clamped', needsClamp);
    button.hidden = !needsClamp;
  };

  document.querySelectorAll<HTMLElement>('.project-description').forEach((description) => {
    // ResizeObserver's callback always runs after layout has settled, unlike a
    // synchronous check on script load, which can measure before final layout.
    new ResizeObserver(() => updateClamping(description)).observe(description);
  });

  document.querySelectorAll<HTMLButtonElement>('.project-expand').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('aria-controls');
      const description = id ? document.getElementById(id) : null;
      if (!description) return;

      const expanded = description.classList.toggle('is-expanded');
      description.classList.toggle('is-clamped', !expanded);
      button.textContent = expanded ? 'Show less' : 'Show more';
      button.setAttribute('aria-expanded', String(expanded));
    });
  });
</script>

<style>
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 0.25rem;
  }

  .role {
    color: var(--color-text-dim);
    margin: 0 0 2rem;
  }

  .bio {
    max-width: 34rem;
  }

  .portfolio {
    margin-top: 3rem;
  }

  h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }

  .project {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg-raised);
    text-decoration: none;
  }

  .project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }

  .project-content {
    flex: 1 1 auto;
    min-width: 0;
    padding-right: 1.5rem;
  }

  .project--expandable {
    display: block;
  }

  .project + .project {
    margin-top: 0.75rem;
  }

  .project:hover,
  .project:focus-visible,
  .project--expandable:hover,
  .project--expandable:focus-within {
    border-color: var(--color-accent);
  }

  .project-main {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .project-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    fill: var(--color-text-dim);
  }

  .project:hover .project-icon,
  .project:focus-visible .project-icon,
  .project--expandable:hover .project-icon,
  .project--expandable:focus-within .project-icon {
    fill: var(--color-accent);
  }

  .project-title {
    font-family: var(--font-display);
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .project-meta {
    color: var(--color-accent-bright);
    font-size: 0.9rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-description {
    margin: 0.4rem 0 0;
    color: var(--color-text-dim);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .project-description.is-clamped {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .project-expand[hidden] {
    display: none;
  }

  .project-expand {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-accent-bright);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .project-expand:hover,
  .project-expand:focus-visible {
    text-decoration: underline;
  }
</style>
