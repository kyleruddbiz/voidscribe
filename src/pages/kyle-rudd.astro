---
import Layout from '../layouts/Layout.astro';
import RoleFilter from '../components/RoleFilter.svelte';
import PortfolioList from '../components/PortfolioList.svelte';
import { kyleRudd } from '../content/kyle-rudd';
---

<Layout title={kyleRudd.name} description={kyleRudd.tagline}>
  <section class="profile">
    <h1>{kyleRudd.name}</h1>
    <RoleFilter client:load roles={kyleRudd.roles} />

    <p class="bio">Bio coming soon.</p>

    <section class="portfolio">
      <h2>Portfolio</h2>
      <PortfolioList
        client:load
        items={kyleRudd.portfolio}
        roles={kyleRudd.roles}
      />
    </section>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 0.25rem;
  }

  .bio {
    max-width: var(--measure);
  }

  .portfolio {
    margin-top: 3rem;
  }

  h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
</style>
