---
import Layout from '../../layouts/Layout.astro';
import PortfolioPage from '../../components/PortfolioPage.svelte';
import LoopingVideo from '../../components/LoopingVideo.svelte';
import { kyleRudd } from '../../content/kyle-rudd';
import { firstLandingHref } from '../../lib/landing-destination';
import type { LinkPortfolioEntry } from '../../lib/portfolio';

export function getStaticPaths() {
  return kyleRudd.portfolio
    .filter(
      (entry): entry is LinkPortfolioEntry & { page: { slug: string } } =>
        entry.kind === 'link' && entry.page !== undefined,
    )
    .map((entry) => ({ params: { slug: entry.page.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const plainTitle = entry.title.replace(/<[^>]*>/g, '');
---

<Layout title={plainTitle} description={entry.description}>
  <a
    slot="header-end"
    class="back-link"
    data-back-link
    href={firstLandingHref()}
  >
    &larr; Portfolio
  </a>
  <PortfolioPage {entry}>
    {
      entry.page.media?.map((item) => (
        <div class="page-media">
          {item.kind === 'image' ? (
            <img
              src={item.image.src}
              srcset={item.image.srcset}
              sizes={item.image.sizes}
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <LoopingVideo client:visible {...item.video} />
          )}
        </div>
      ))
    }
  </PortfolioPage>
</Layout>

<script>
  import { returnLandingHref } from '../../lib/landing-destination';

  const backLink =
    document.querySelector<HTMLAnchorElement>('[data-back-link]');

  if (backLink) {
    backLink.href = returnLandingHref();
  }
</script>

<style>
  .page-media {
    max-width: var(--measure);
    margin-top: 1.25rem;
  }

  .page-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .back-link {
    color: var(--color-accent-bright);
    font-size: 0.9rem;
    text-decoration: none;
  }
</style>
