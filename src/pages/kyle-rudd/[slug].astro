---
import Layout from '../../layouts/Layout.astro';
import PortfolioPage from '../../components/PortfolioPage.svelte';
import { kyleRudd } from '../../content/kyle-rudd';
import BackToPortfolioLink from '../../components/BackToPortfolioLink.astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { LinkPortfolioEntry } from '../../lib/portfolio';

export function getStaticPaths() {
  const detailsModules = import.meta.glob<{ default: AstroComponentFactory }>(
    '../../content/kyle-rudd/portfolio/*/details.astro',
    { eager: true },
  );

  const detailsBySlug = new Map(
    Object.entries(detailsModules).map(([path, module]) => [
      path.split('/').at(-2),
      module.default,
    ]),
  );

  return kyleRudd.portfolio
    .filter(
      (entry): entry is LinkPortfolioEntry & { page: { slug: string } } =>
        entry.kind === 'link' && entry.page !== undefined,
    )
    .map((entry) => {
      const Details = detailsBySlug.get(entry.page.slug);

      if (!Details) {
        throw new Error(
          `Portfolio entry “${entry.page.slug}” has a page but no details.astro in a folder of that name.`,
        );
      }

      return { params: { slug: entry.page.slug }, props: { entry, Details } };
    });
}

const { entry, Details } = Astro.props;
const plainTitle = entry.title.replace(/<[^>]*>/g, '');
---

<Layout title={plainTitle} description={entry.description}>
  <BackToPortfolioLink slot="header-end" />
  <PortfolioPage {entry}>
    <Details />
  </PortfolioPage>
</Layout>
