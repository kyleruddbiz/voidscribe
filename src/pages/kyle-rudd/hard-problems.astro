---
import Layout from '../../layouts/Layout.astro';
import BackToPortfolioLink from '../../components/BackToPortfolioLink.astro';
import PageVideoPlayer from '../../components/PageVideoPlayer.astro';
import pixelDiffingPoster from '../../content/kyle-rudd/hard-problems/pixel-diffing.jpg';
import pixelDiffingVideo from '../../content/kyle-rudd/hard-problems/pixel-diffing.mp4?url';
---

<Layout title="Hard Problems" noindex>
  <BackToPortfolioLink slot="header-end" />
  <h1 class="page-title">Pixel Diffing</h1>
  <div class="page-body">
    <PageVideoPlayer
      poster={pixelDiffingPoster}
      src={pixelDiffingVideo}
      label="Pixel diffing walkthrough"
    />
  </div>
</Layout>

<style>
  .page-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2rem);
    font-weight: normal;
    color: var(--color-text);
  }

  .page-body {
    color: var(--color-text-dim);
    line-height: 1.6;
  }

  .page-body p {
    margin: 0;
  }

  .page-body :global(video) {
    margin-top: 1.75rem;
  }
</style>
